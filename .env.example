# --- Infrastructure (docker compose overrides the hosts for containers) ---
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0

# --- Required by SEC: identify yourself (name + email) ---
SEC_USER_AGENT=SENTINEL Hackathon your.name@college.ac.in

# --- Free API keys you add yourself ---
FRED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentinel-hackathon/0.1 by your_reddit_username

# --- Polling intervals (seconds) ---
GDELT_POLL_SECONDS=900
RSS_POLL_SECONDS=300
EDGAR_POLL_SECONDS=600
REDDIT_POLL_SECONDS=120

# --- API ---
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- API hardening ---
# Bearer token required for write endpoints (index config/approve, stress run/rules, demo inject). Empty = open (dev only).
API_TOKEN=
RATE_LIMIT_PER_MINUTE=600
WRITE_RATE_LIMIT_PER_MINUTE=60

# --- Pipeline ---
AUDIT_MIN_IMPACT=7.0
REPLAY_PACE_SECONDS=1.0
